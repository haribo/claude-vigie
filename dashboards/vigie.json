{
  "title": "Claude Vigie — daemon",
  "uid": "vigie",
  "tags": ["vigie"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Vigie",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Sessions by status",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "stacking": { "mode": "none" }, "fillOpacity": 8 } } },
      "targets": [
        { "refId": "A", "expr": "vigie_sessions", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "stat",
      "title": "Watcher heartbeat age",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 60 } ] } } },
      "targets": [
        { "refId": "A", "expr": "time() - vigie_watcher_last_seen_timestamp_seconds", "legendFormat": "age" }
      ]
    },
    {
      "type": "stat",
      "title": "Build",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "vigie_build_info", "legendFormat": "{{version}} ({{go_version}})", "instant": true }
      ]
    },
    {
      "type": "row",
      "title": "HTTP API (RED)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries",
      "title": "Request rate by route",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (rate(vigie_http_requests_total[$__rate_interval]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx error rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (rate(vigie_http_requests_total{code=~\"5..\"}[$__rate_interval]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 / p50",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(vigie_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "B", "expr": "histogram_quantile(0.50, sum by (le) (rate(vigie_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50" }
      ]
    },
    {
      "type": "stat",
      "title": "In-flight requests",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 18 },
      "targets": [ { "refId": "A", "expr": "vigie_http_requests_in_flight", "legendFormat": "in-flight" } ]
    },
    {
      "type": "stat",
      "title": "SSE subscribers",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 18 },
      "targets": [ { "refId": "A", "expr": "vigie_sse_subscribers", "legendFormat": "subscribers" } ]
    },
    {
      "type": "stat",
      "title": "DB size",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [ { "refId": "A", "expr": "vigie_db_size_bytes", "legendFormat": "db" } ]
    },
    {
      "type": "stat",
      "title": "Sessions pruned (total)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 18 },
      "targets": [ { "refId": "A", "expr": "vigie_sessions_pruned_total", "legendFormat": "pruned" } ]
    },
    {
      "type": "row",
      "title": "Ingestion",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "type": "timeseries",
      "title": "Reports by event",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "refId": "A", "expr": "sum by (event) (rate(vigie_reports_total[$__rate_interval]))", "legendFormat": "{{event}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Output tokens by model",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "sum by (model) (rate(vigie_output_tokens_total[$__rate_interval]))", "legendFormat": "{{model}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rejected reports & SSE fan-out",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "sum by (reason) (rate(vigie_reports_rejected_total[$__rate_interval]))", "legendFormat": "rejected {{reason}}" },
        { "refId": "B", "expr": "rate(vigie_sse_events_published_total[$__rate_interval])", "legendFormat": "sse published" }
      ]
    }
  ]
}
