# Build artifacts
/bin/
/dist/
# `go build ./tools/<name>` drops its binary in the working directory, named after
# the command — and a tool binary committed once is a tool binary committed again.
/capture
/drive
/residual

# Local dev environment (dev-fleet-* recipes)
/.dev/
*.out
*.html
# ...but the web dashboard's embedded shell and the landing page are source, not
# generated artifacts.
!internal/web/static/*.html
!site/*.html
coverage.*

# Local dev database
*.db
*.db-shm
*.db-wal

# Logs
/logs/

# Generated audit reports (working documents)
/docs/generated/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Local Claude settings (permissions allowlist, machine-specific)
.claude/settings.local.json
