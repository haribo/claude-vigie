# Static hosting for the claude-vigie landing page (claudevigie.org).
# This serves ONLY the marketing site. It is unrelated to the vigied daemon,
# which runs elsewhere and exposes its own API (e.g. api.claudevigie.org).
#
# Deploy: sync site/ to the root below, then `caddy reload`.

www.claudevigie.org {
	redir https://claudevigie.org{uri} permanent
}

claudevigie.org {
	root * /srv/claudevigie.org
	file_server
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The page inlines its own CSS/JS and draws the radar on a canvas — no
		# third-party origins, no remote fetches. 'unsafe-inline' covers the
		# inline <style>/<script>; everything else stays same-origin.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'"
	}
}
